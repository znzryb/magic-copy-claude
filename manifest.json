{
  "manifest_version": 3,
  "name": "Magic Copy for Claude",
  "version": "0.1.0",
  "description": "选中 Claude 对话中的任意片段，一键复制为 Markdown：KaTeX 公式还原成 LaTeX，列表 / 代码块 / 表格 / 加粗全部保留。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://*.claude.ai/*"],
      "js": ["src/markdown.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Magic Copy for Claude",
    "default_popup": "src/options.html"
  }
}
